{
  "name": "zama",
  "version": "1.0.0",
  "description": "**Foundry is a blazing fast, portable and modular toolkit for Ethereum application development written in Rust.**",
  "type": "module",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "test": "forge test --offline",
    "test:local": "node_modules/node/bin/node node_modules/tsx/dist/cli.mjs integration/local.ts",
    "test:local:full": "bash integration/run-local.sh",
    "typecheck:local": "node_modules/node/bin/node node_modules/typescript/bin/tsc --noEmit -p integration/tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fhevm/solidity": "^0.11.1",
    "@openzeppelin/confidential-contracts": "^0.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@zama-fhe/sdk": "^3.5.1",
    "dotenv": "^17.4.2",
    "node": "^22.23.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "viem": "^2.56.3"
  }
}
